{
    "packages": {
        "newfold-labs/wp-module-hosting": [
            {
                "name": "newfold-labs/wp-module-hosting",
                "version": "dev-main",
                "version_normalized": "dev-main",
                "source": {
                    "type": "git",
                    "url": "https://github.com/newfold-labs/wp-module-hosting.git",
                    "reference": "7b88d5235efb34ec95f4229896554629c63fac98"
                },
                "dist": {
                    "type": "zip",
                    "url": "https://api.github.com/repos/newfold-labs/wp-module-hosting/zipball/7b88d5235efb34ec95f4229896554629c63fac98",
                    "reference": "7b88d5235efb34ec95f4229896554629c63fac98",
                    "shasum": ""
                },
                "require": {
                    "newfold-labs/wp-module-data": "^2.9"
                },
                "require-dev": {
                    "newfold-labs/wp-php-standards": "^1.2",
                    "wp-cli/i18n-command": "^2.6.6",
                    "wp-cli/wp-cli": "^2.12"
                },
                "time": "2026-08-11T18:48:35+00:00",
                "default-branch": true,
                "type": "library",
                "autoload": {
                    "psr-4": {
                        "NewfoldLabs\\WP\\Module\\Hosting\\": "includes"
                    },
                    "files": [
                        "bootstrap.php"
                    ]
                },
                "scripts": {
                    "fix": [
                        "vendor/bin/phpcbf . --standard=phpcs.xml"
                    ],
                    "i18n-pot": [
                        "vendor/bin/wp i18n make-pot . ./languages/wp-module-hosting.pot --domain=wp-module-hosting --headers='{\"Report-Msgid-Bugs-To\":\"https://github.com/newfold-labs/wp-module-hosting/issues\",\"POT-Creation-Date\":\"2025-02-13T09:55:55+00:00\"}' --exclude=src,scripts,tests,webpack --include=build/*.min.js,includes"
                    ],
                    "i18n-po": [
                        "vendor/bin/wp i18n update-po ./languages/wp-module-hosting.pot ./languages"
                    ],
                    "i18n-php": [
                        "vendor/bin/wp i18n make-php ./languages"
                    ],
                    "i18n-json": [
                        "rm -f languages/*.json && vendor/bin/wp i18n make-json ./languages --no-purge --pretty-print"
                    ],
                    "i18n": [
                        "@i18n-pot",
                        "@i18n-po",
                        "@i18n-php",
                        "@i18n-json"
                    ],
                    "lint": [
                        "vendor/bin/phpcs . --standard=phpcs.xml -s"
                    ]
                },
                "license": [
                    "GPL-3.0-or-later"
                ],
                "authors": [
                    {
                        "name": "arunshenoy99",
                        "email": "devarunshenoy99@gmail.com"
                    }
                ],
                "description": "A Newfold module that manages the Hosting panel on the plugin page and serves as middleware for interacting with hosting services."
            }
        ]
    }
}
