                    "johnpbloch/wordpress": "@stable",
                    "lucatume/wp-browser": "*",
                    "newfold-labs/wp-php-standards": "^2.0",
                    "phpunit/phpcov": "*",
                    "wp-cli/i18n-command": "^2.7.0"
                },
                "time": "2026-09-09T14:45:40+00:00",
                "type": "library",
                "autoload": {
                    "psr-4": {
                        "NewfoldLabs\\WP\\Module\\Solutions\\": "includes"
                    },
