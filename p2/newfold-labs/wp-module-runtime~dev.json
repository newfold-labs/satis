{
    "packages": {
        "newfold-labs/wp-module-runtime": [
            {
                "name": "newfold-labs/wp-module-runtime",
                "version": "dev-auto-translate/main",
                "version_normalized": "dev-auto-translate/main",
                "source": {
                    "type": "git",
                    "url": "https://github.com/newfold-labs/wp-module-runtime.git",
                    "reference": "f899abfc8cc4d8846721346062c95aa9a182105a"
                },
                "dist": {
                    "type": "zip",
                    "url": "https://api.github.com/repos/newfold-labs/wp-module-runtime/zipball/f899abfc8cc4d8846721346062c95aa9a182105a",
                    "reference": "f899abfc8cc4d8846721346062c95aa9a182105a",
                    "shasum": ""
                },
                "require-dev": {
                    "johnpbloch/wordpress": "@stable",
                    "lucatume/wp-browser": "*",
                    "newfold-labs/wp-module-loader": "^1.1",
                    "newfold-labs/wp-php-standards": "^2.0",
                    "phpunit/phpcov": "*",
                    "wp-cli/i18n-command": "@stable",
                    "wp-cli/wp-cli-bundle": "@stable"
                },
                "time": "2026-09-15T18:33:10+00:00",
                "type": "library",
                "autoload": {
                    "psr-4": {
                        "NewfoldLabs\\WP\\Module\\Runtime\\": "includes"
                    },
                    "files": [
                        "bootstrap.php"
                    ]
                },
                "scripts": {
                    "fix": [
                        "vendor/bin/phpcbf --standard=phpcs.xml ."
                    ],
                    "lint": [
                        "vendor/bin/phpcs --standard=phpcs.xml -s ."
                    ],
                    "i18n-pot": [
                        "vendor/bin/wp i18n make-pot . ./languages/wp-module-runtime.pot --domain=wp-module-runtime --headers='{\"Report-Msgid-Bugs-To\":\"https://github.com/newfold-labs/wp-module-runtime/issues\",\"POT-Creation-Date\":\"2025-02-13T09:55:55+00:00\"}' --exclude=tests,vendor,wordpress,node_modules,build"
                    ],
                    "i18n-po": [
                        "vendor/bin/wp i18n update-po ./languages/wp-module-runtime.pot ./languages"
                    ],
                    "i18n-php": [
                        "vendor/bin/wp i18n make-php ./languages --pretty-print"
                    ],
                    "i18n-json": [
                        "rm -f languages/*.json && vendor/bin/wp i18n make-json ./languages --pretty-print"
                    ],
                    "i18n": [
                        "@i18n-pot",
                        "@i18n-po",
                        "@i18n-php",
                        "@i18n-json"
                    ],
                    "i18n-ci-pre": [
                        "@i18n-pot",
                        "@i18n-po"
                    ],
                    "i18n-ci-post": [
                        "@i18n-json",
                        "@i18n-php"
                    ],
                    "test": [
                        "codecept run wpunit"
                    ],
                    "test-coverage": [
                        "codecept run wpunit --coverage wpunit.cov && phpcov merge --php tests/_output/merged.cov --html tests/_output/html tests/_output && echo \"open tests/_output/html/index.html to view the report\""
                    ]
                },
                "license": [
                    "GPL-2.0-or-later"
                ],
                "authors": [
                    {
                        "name": "Beyond",
                        "email": "team-spartans@newfold.com"
                    }
                ],
                "description": "Runtime for Newfold WP modules and plugins"
            },
